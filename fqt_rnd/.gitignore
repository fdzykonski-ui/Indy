# Reconstructed upstream source and multi-gigabyte market data are immutable inputs.
/reconstruction/

# Raw imported evidence can contain credentials or large supplied research inputs.
# Its bounded hashes and findings are preserved under audit/.
/evidence/
/quarantine/

# Generated/runtime material.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
/results/raw/
/results/**/*.zip
/results/**/*.meta.json
/results/**/.last_result.json
/runtime/
*.sqlite
*.sqlite-shm
*.sqlite-wal
!/report/report_data.sqlite
/release/*.zip

# Secret-bearing or local-only configuration overrides.
config-private*.json
secrets*.json
.env
.env.*
