+class _CompactBacktestRows:
+    """Columnar event matrix with lazy row materialization.
+
+    Avoids allocating millions of timezone-aware ``Timestamp`` and repeated tag
+    objects at once. ``Backtesting`` only requires ``len`` and integer indexing,
+    so rows are reconstructed on demand with the exact HEADERS ordering.
+    """
+
+    __slots__ = (
+        "date_ns", "prices", "signals", "enter_codes", "exit_codes",
+        "enter_values", "exit_values", "size",
+    )
+
+    def __init__(self, frame: DataFrame) -> None:
+        dates = pd.to_datetime(frame["date"], utc=True, errors="raise")
+        self.date_ns = dates.dt.as_unit("ns").array.asi8.copy()
+        self.prices = np.column_stack(
+            [
+                pd.to_numeric(frame[col], errors="coerce").to_numpy(
+                    dtype=np.float64, copy=False
+                )
+                for col in ("open", "high", "low", "close")
+            ]
+        )
+        self.signals = np.column_stack(
+            [
+                pd.to_numeric(frame[col], errors="coerce")
+                .fillna(0)
+                .to_numpy(dtype=np.int8, copy=False)
+                for col in ("enter_long", "exit_long", "enter_short", "exit_short")
+            ]
+        )
+        enter_codes, enter_values = pd.factorize(
+            frame["enter_tag"], sort=False, use_na_sentinel=True
+        )
+        exit_codes, exit_values = pd.factorize(
+            frame["exit_tag"], sort=False, use_na_sentinel=True
+        )
+        self.enter_codes = enter_codes.astype(np.int32, copy=False)
+        self.exit_codes = exit_codes.astype(np.int32, copy=False)
+        self.enter_values = tuple(enter_values.tolist())
+        self.exit_values = tuple(exit_values.tolist())
+        self.size = len(frame)
+
+    def __len__(self) -> int:
+        return self.size
+
+    def __getitem__(self, index: int):
+        if not isinstance(index, (int, np.integer)):
+            raise TypeError("Compact backtest rows support integer indexing only")
+        i = int(index)
+        if i < 0:
+            i += self.size
+        if i < 0 or i >= self.size:
+            raise IndexError(i)
+        ec = int(self.enter_codes[i])
+        xc = int(self.exit_codes[i])
+        enter_tag = None if ec < 0 else self.enter_values[ec]
+        exit_tag = None if xc < 0 else self.exit_values[xc]
+        prices = self.prices[i]
+        signals = self.signals[i]
+        return (
+            pd.Timestamp(int(self.date_ns[i]), unit="ns", tz="UTC"),
+            float(prices[0]), float(prices[1]), float(prices[2]), float(prices[3]),
+            int(signals[0]), int(signals[1]), int(signals[2]), int(signals[3]),
+            enter_tag, exit_tag,
+        )
+
+
+def _compact_backtest_rows(frame: DataFrame):
+    """Return a compact columnar sequence with lazy row reconstruction."""
+    if frame.empty:
+        return []
+    return _CompactBacktestRows(frame)
+
